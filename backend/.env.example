# Port to run the Express backend on
PORT=5000

# MongoDB Connection String (Atlas or Local Instance)
MONGO_URI=mongodb://127.0.0.1:27017/talentai

# Secret key used for signing and verifying JWT tokens
JWT_SECRET=your_jwt_signing_secret_key_here

# Google Gemini Pro / Flash API Key
# If omitted or invalid, the platform automatically utilizes a local mock parser
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Optional secondary backup fallback)
# Used if Gemini API quota gets exhausted or is omitted
OPENROUTER_API_KEY=your_openrouter_api_key_here
